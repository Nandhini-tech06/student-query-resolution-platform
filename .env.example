# Project Configuration
PROJECT_NAME="Student Query Resolution Platform"
API_V1_STR="/api/v1"

# Security (Generate a new secret for production!)
SECRET_KEY="temporary-secret-key-change-in-production-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/student_query_db"

# Development Fallback (auto-falls back to SQLite if MySQL service is not running locally)
ENABLE_SQLITE_FALLBACK=True
SQLITE_FALLBACK_URL="sqlite:///./student_query_platform.db"

# Seed Admin Account
FIRST_ADMIN_EMAIL="admin@platform.edu"
FIRST_ADMIN_PASSWORD="Admin@12345"
FIRST_ADMIN_NAME="Platform Administrator"
